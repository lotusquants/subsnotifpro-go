# ==================================
# SECURITY & MIDDLEWARE CONFIGURATION
# ==================================

# Rate Limiting Configuration
RATE_LIMIT_RPS=10.0
RATE_LIMIT_BURST=20
RATE_LIMIT_TTL_MINUTES=60

# Strict Rate Limiting (for sensitive endpoints)
STRICT_RATE_LIMIT_RPS=2.0
STRICT_RATE_LIMIT_BURST=5
STRICT_RATE_LIMIT_TTL_MINUTES=5

# Webhook Rate Limiting
WEBHOOK_RATE_LIMIT_RPS=50.0
WEBHOOK_RATE_LIMIT_BURST=100

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080
PROD_CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Security Configuration
SECURITY_MAX_REQUEST_SIZE=10485760  # 10MB in bytes
SECURITY_REQUEST_TIMEOUT=30s
SECURITY_FORCE_HTTPS=false
SECURITY_ENABLE_API_KEY_AUTH=false

# API Keys (comma-separated, only set in production)
# API_KEYS=your-api-key-1,your-api-key-2

# IP Whitelist (comma-separated, only set if needed)
# ALLOWED_IPS=192.168.1.100,10.0.0.50

# Request Logging Configuration
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true
LOG_HEADERS=true
LOG_MAX_BODY_SIZE=10240  # 10KB
LOG_LEVEL=info

# Production overrides (set these in production environment)
PROD_LOG_REQUEST_BODY=false
PROD_LOG_RESPONSE_BODY=false
PROD_LOG_HEADERS=false
PROD_LOG_LEVEL=warn

# Content Security Policy
CSP_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none';"

# Request Validation
VALIDATION_MAX_BODY_SIZE=10485760  # 10MB
VALIDATION_REQUIRE_CONTENT_TYPE=true
VALIDATION_ALLOWED_CONTENT_TYPES=application/json,application/x-www-form-urlencoded,multipart/form-data
