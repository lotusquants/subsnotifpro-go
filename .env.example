# Database Configuration
# Choose deployment mode: 'container', 'managed', or 'external'
DB_DEPLOYMENT_MODE=container

# Database Type
DB_TYPE=postgres

# Basic Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=subsnotifpro_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# Connection Pool Settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=15m

# Additional Settings
DB_QUERY_LOGGING=false
DB_SSL_REQUIRED=false

# Azure Database Configuration (used when DB_DEPLOYMENT_MODE=managed)
DB_AZURE_USE_MANAGED_IDENTITY=false
DB_AZURE_SERVER_NAME=your-server.postgres.database.azure.com
DB_AZURE_RESOURCE_ID=/subscriptions/your-subscription/resourceGroups/your-rg/providers/Microsoft.DBforPostgreSQL/servers/your-server
DB_AZURE_TENANT_ID=your-tenant-id
DB_AZURE_SSL_MODE=require
DB_AZURE_SSL_ROOT_CERT=/path/to/ssl/root/cert.pem
DB_AZURE_CONNECT_TIMEOUT=30s
DB_AZURE_READ_TIMEOUT=30s
DB_AZURE_WRITE_TIMEOUT=30s

# Server Configuration
SERVER_PORT=8080

# Messaging Configuration
# Choose between 'rabbitmq' or 'servicebus'
MESSAGING_TYPE=rabbitmq

# RabbitMQ Configuration (used when MESSAGING_TYPE=rabbitmq)
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_CONNECTION_NAME=subsnotifpro-connection
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY=5s
RABBITMQ_WORKER_COUNT=5

# RabbitMQ Queue Configuration
RABBITMQ_RTDN_EXCHANGE=google-play-rtdn
RABBITMQ_RTDN_QUEUE=google-play-rtdn-queue
RABBITMQ_RTDN_ROUTING_KEY=google-play-rtdn
RABBITMQ_RTDN_DLX=google-play-rtdn-dlx
RABBITMQ_RTDN_DLQ=google-play-rtdn-dlq
RABBITMQ_RTDN_DLQ_ROUTING_KEY=google-play-rtdn-dlq

RABBITMQ_APPSTORE_EXCHANGE=app-store-notifications
RABBITMQ_APPSTORE_QUEUE=app-store-notifications-queue
RABBITMQ_APPSTORE_ROUTING_KEY=app-store-notifications
RABBITMQ_APPSTORE_DLX=app-store-notifications-dlx
RABBITMQ_APPSTORE_DLQ=app-store-notifications-dlq
RABBITMQ_APPSTORE_DLQ_ROUTING_KEY=app-store-notifications-dlq

RABBITMQ_UNIFIED_SUBS_EXCHANGE=unified-subscriptions
RABBITMQ_UNIFIED_SUBS_QUEUE=unified-subscriptions-queue
RABBITMQ_UNIFIED_SUBS_ROUTING_KEY=unified-subscriptions
RABBITMQ_UNIFIED_SUBS_DLX=unified-subscriptions-dlx
RABBITMQ_UNIFIED_SUBS_DLQ=unified-subscriptions-dlq
RABBITMQ_UNIFIED_SUBS_DLQ_ROUTING_KEY=unified-subscriptions-dlq

# Azure Service Bus Configuration (used when MESSAGING_TYPE=servicebus)
# Either use connection string OR namespace with managed identity
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your-key
SERVICEBUS_NAMESPACE=your-namespace.servicebus.windows.net
SERVICEBUS_USE_MANAGED_IDENTITY=false
SERVICEBUS_MAX_RETRIES=3
SERVICEBUS_WORKER_COUNT=5

# Service Bus Topic Configuration
SERVICEBUS_RTDN_TOPIC=google-play-rtdn
SERVICEBUS_RTDN_SUBSCRIPTION=google-play-rtdn-subscription
SERVICEBUS_APPSTORE_TOPIC=app-store-notifications
SERVICEBUS_APPSTORE_SUBSCRIPTION=app-store-notifications-subscription
SERVICEBUS_UNIFIED_SUBS_TOPIC=unified-subscriptions
SERVICEBUS_UNIFIED_SUBS_SUBSCRIPTION=unified-subscriptions-subscription

# Batch Configuration
SYNC_BATCH_SIZE=50
